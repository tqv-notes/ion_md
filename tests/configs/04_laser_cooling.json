{
  "_description": "Doppler cooling of a hot cloud of 300 40Ca+ ions (Zhang et al. PRA 76 012719 Sec. II D, Fig. 9). The secular temperature must decay approximately as exp(-beta t / m) and the ensemble crystallises (see the CCD image).",
  "simulation": { "dt": 20e-9, "num_steps": 100000, "initial_temperature": 0.5,
                  "equilibrate_steps": 20000, "seed": 4, "backend": "auto",
                  "progress_every": 20000 },
  "forces": { "secular": true, "coulomb": true, "doppler": true },
  "trap": { "r0": 3.5e-3, "z0": 2.7e-3, "kappa": 0.248, "f_rf": 4.972e6,
            "V_rf": 300, "U_dc": 0.0, "U_ec": 1.0 },
  "lasers": [ { "khat": [0, 0, 1], "beta": 2e-22, "F0": 0.0 } ],
  "ions": [ { "label": "Ca40", "mass": 40, "charge": 1, "count": 300 } ],
  "initial": { "mode": "random", "radial_extent": 60e-6, "axial_extent": 150e-6 },
  "output": { "record_every": 1000, "diag_every": 500,
              "ccd": { "enabled": true, "bins": 300, "extent": 150e-6,
                       "every": 10, "start": 60000 } }
}
