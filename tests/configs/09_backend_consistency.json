{
  "_description": "Short run of a large cloud used to compare the CPU (OpenMP) and CUDA backends. Run with --backend cpu and with --backend cuda; final states must agree to ~1e-9 relative (before chaos amplifies round-off differences).",
  "simulation": { "dt": 20e-9, "num_steps": 200, "seed": 9, "backend": "cpu" },
  "forces": { "secular": true, "coulomb": true, "doppler": true, "stochastic": true },
  "stochastic": { "heating_rate": 20.0 },
  "trap": { "r0": 3.5e-3, "z0": 2.7e-3, "kappa": 0.248, "f_rf": 4.972e6,
            "V_rf": 300, "U_dc": 0.0, "U_ec": 1.0 },
  "lasers": [ { "khat": [0, 0, 1], "beta": 2e-22, "F0": 0.0 } ],
  "ions": [ { "label": "Ca40", "mass": 40, "charge": 1, "count": 3000 } ],
  "initial": { "mode": "random", "radial_extent": 150e-6, "axial_extent": 400e-6,
               "temperature": 0.01 },
  "output": { "record_every": 0, "diag_every": 50 }
}
